{
  "id": "mountain-still-10",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 138,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 1.992
    },
    {
      "index": 1,
      "text": "Prenditi il tempo per arrivare.",
      "file": "c001.ogg",
      "durationSec": 3.36
    },
    {
      "index": 2,
      "text": "Siediti o sdraiati con supporto.",
      "file": "c002.ogg",
      "durationSec": 4.248
    },
    {
      "index": 3,
      "text": "Chiudi gli occhi se ti sembra sicuro.",
      "file": "c003.ogg",
      "durationSec": 3.696
    },
    {
      "index": 4,
      "text": "Senti il contatto con il suolo.",
      "file": "c004.ogg",
      "durationSec": 3.744
    },
    {
      "index": 5,
      "text": "Respiro lento dentro.",
      "file": "c005.ogg",
      "durationSec": 3.024
    },
    {
      "index": 6,
      "text": "Respiro lungo fuori.",
      "file": "c006.ogg",
      "durationSec": 3.024
    },
    {
      "index": 7,
      "text": "[pausa:28]",
      "file": "c007.ogg",
      "durationSec": 3.072
    },
    {
      "index": 8,
      "text": "Ancora.",
      "file": "c008.ogg",
      "durationSec": 1.872
    },
    {
      "index": 9,
      "text": "[pausa:28]",
      "file": "c009.ogg",
      "durationSec": 3.072
    },
    {
      "index": 10,
      "text": "Lascia che le spalle si abbassino.",
      "file": "c010.ogg",
      "durationSec": 3.768
    },
    {
      "index": 11,
      "text": "Lascia che la pancia si rilassi.",
      "file": "c011.ogg",
      "durationSec": 3.552
    },
    {
      "index": 12,
      "text": "[pausa:36]",
      "file": "c012.ogg",
      "durationSec": 3.288
    },
    {
      "index": 13,
      "text": "Immagina te stesso come una montagna.",
      "file": "c013.ogg",
      "durationSec": 4.536
    },
    {
      "index": 14,
      "text": "Base larga. Picco tranquillo. Grande pazienza.",
      "file": "c014.ogg",
      "durationSec": 6.768
    },
    {
      "index": 15,
      "text": "[pausa:43]",
      "file": "c015.ogg",
      "durationSec": 3.456
    },
    {
      "index": 16,
      "text": "Il tempo si muove sulla montagna.",
      "file": "c016.ogg",
      "durationSec": 4.104
    },
    {
      "index": 17,
      "text": "Sole. Vento. Nuvola. Tempesta.",
      "file": "c017.ogg",
      "durationSec": 6.6
    },
    {
      "index": 18,
      "text": "La montagna rimane.",
      "file": "c018.ogg",
      "durationSec": 2.688
    },
    {
      "index": 19,
      "text": "[pausa:57]",
      "file": "c019.ogg",
      "durationSec": 3.96
    },
    {
      "index": 20,
      "text": "Pensieri e umori sono il tempo.",
      "file": "c020.ogg",
      "durationSec": 3.912
    },
    {
      "index": 21,
      "text": "Tu sei la montagna.",
      "file": "c021.ogg",
      "durationSec": 2.736
    },
    {
      "index": 22,
      "text": "[pausa:57]",
      "file": "c022.ogg",
      "durationSec": 3.96
    },
    {
      "index": 23,
      "text": "Senti la base del tuo corpo radicata.",
      "file": "c023.ogg",
      "durationSec": 4.368
    },
    {
      "index": 24,
      "text": "Senti l'altezza nella colonna senza sforzo.",
      "file": "c024.ogg",
      "durationSec": 4.992
    },
    {
      "index": 25,
      "text": "[pausa:43]",
      "file": "c025.ogg",
      "durationSec": 3.456
    },
    {
      "index": 26,
      "text": "Respira come il cielo intorno alla montagna.",
      "file": "c026.ogg",
      "durationSec": 4.728
    },
    {
      "index": 27,
      "text": "[pausa:71]",
      "file": "c027.ogg",
      "durationSec": 3.648
    },
    {
      "index": 28,
      "text": "Stabile. Senza fretta. Abbastanza.",
      "file": "c028.ogg",
      "durationSec": 5.808
    },
    {
      "index": 29,
      "text": "[pausa:90]",
      "file": "c029.ogg",
      "durationSec": 3.024
    },
    {
      "index": 30,
      "text": "[pausa:43]",
      "file": "c030.ogg",
      "durationSec": 3.456
    },
    {
      "index": 31,
      "text": "Inizia a approfondire il respiro.",
      "file": "c031.ogg",
      "durationSec": 3.936
    },
    {
      "index": 32,
      "text": "Senti di nuovo la stanza.",
      "file": "c032.ogg",
      "durationSec": 3.336
    },
    {
      "index": 33,
      "text": "Muovi dita delle mani e dei piedi.",
      "file": "c033.ogg",
      "durationSec": 4.056
    },
    {
      "index": 34,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c034.ogg",
      "durationSec": 4.488
    },
    {
      "index": 35,
      "text": "Muoviti lentamente verso ciò che segue.",
      "file": "c035.ogg",
      "durationSec": 4.416
    }
  ]
}
