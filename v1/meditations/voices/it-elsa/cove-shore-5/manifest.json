{
  "id": "cove-shore-5",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 295,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 1.992
    },
    {
      "index": 1,
      "text": "Prendi una posizione comoda, o sdraiati se ti sembra meglio.",
      "file": "c001.ogg",
      "durationSec": 6.888
    },
    {
      "index": 2,
      "text": "Lascia che le mani riposino.",
      "file": "c002.ogg",
      "durationSec": 3.312
    },
    {
      "index": 3,
      "text": "Permetti agli occhi di chiudersi, o ammorbidisci lo sguardo.",
      "file": "c003.ogg",
      "durationSec": 6.24
    },
    {
      "index": 4,
      "text": "Nota il peso del tuo corpo che viene sostenuto.",
      "file": "c004.ogg",
      "durationSec": 5.544
    },
    {
      "index": 5,
      "text": "Fai un respiro lento attraverso il naso.",
      "file": "c005.ogg",
      "durationSec": 4.44
    },
    {
      "index": 6,
      "text": "E un respiro più lungo e facile fuori.",
      "file": "c006.ogg",
      "durationSec": 4.512
    },
    {
      "index": 7,
      "text": "Ancora una volta. Inhala dolcemente.",
      "file": "c007.ogg",
      "durationSec": 4.968
    },
    {
      "index": 8,
      "text": "Esala dolcemente.",
      "file": "c008.ogg",
      "durationSec": 2.688
    },
    {
      "index": 9,
      "text": "Se i pensieri vagano, va bene. Ritorna al respiro.",
      "file": "c009.ogg",
      "durationSec": 7.008
    },
    {
      "index": 10,
      "text": "Vedi te stesso arrivare in una baia riparata.",
      "file": "c010.ogg",
      "durationSec": 4.752
    },
    {
      "index": 11,
      "text": "Scogliere si curvano intorno a una morbida sabbia pallida.",
      "file": "c011.ogg",
      "durationSec": 6.432
    },
    {
      "index": 12,
      "text": "Il mare si muove con onde basse e pazienti.",
      "file": "c012.ogg",
      "durationSec": 5.04
    },
    {
      "index": 13,
      "text": "Un sole mite riscalda la parte superiore delle spalle.",
      "file": "c013.ogg",
      "durationSec": 6.336
    },
    {
      "index": 14,
      "text": "Una brezza salmastra rinfresca le labbra e le palpebre.",
      "file": "c014.ogg",
      "durationSec": 6.336
    },
    {
      "index": 15,
      "text": "Senti la freschezza di quell'aria riempire il petto.",
      "file": "c015.ogg",
      "durationSec": 5.52
    },
    {
      "index": 16,
      "text": "Cammina fino alla linea dell'acqua. La sabbia bagnata avvolge i piedi.",
      "file": "c016.ogg",
      "durationSec": 7.944
    },
    {
      "index": 17,
      "text": "Una schiuma fresca tocca le caviglie e scivola via.",
      "file": "c017.ogg",
      "durationSec": 5.808
    },
    {
      "index": 18,
      "text": "Il ritmo è semplice. Arriva. Rilassati. Vai via.",
      "file": "c018.ogg",
      "durationSec": 8.112
    },
    {
      "index": 19,
      "text": "Siediti dove la sabbia asciutta è calda sotto di te.",
      "file": "c019.ogg",
      "durationSec": 5.304
    },
    {
      "index": 20,
      "text": "Appoggiati sulle mani. Senti il calore granuloso.",
      "file": "c020.ogg",
      "durationSec": 6.408
    },
    {
      "index": 21,
      "text": "Ascolta il silenzio e il fruscio della baia.",
      "file": "c021.ogg",
      "durationSec": 4.704
    },
    {
      "index": 22,
      "text": "Senti il sale, il sole e la pietra pulita.",
      "file": "c022.ogg",
      "durationSec": 5.592
    },
    {
      "index": 23,
      "text": "Calore sulla pelle. Freschezza in ogni inspirazione.",
      "file": "c023.ogg",
      "durationSec": 6.36
    },
    {
      "index": 24,
      "text": "Lontano, la luce scintilla come una risata silenziosa.",
      "file": "c024.ogg",
      "durationSec": 6.768
    },
    {
      "index": 25,
      "text": "Non devi inseguirla. È già qui.",
      "file": "c025.ogg",
      "durationSec": 4.392
    },
    {
      "index": 26,
      "text": "Una onda arriva più lontano, raffredda le dita dei piedi, poi si ritira.",
      "file": "c026.ogg",
      "durationSec": 8.976
    },
    {
      "index": 27,
      "text": "La sabbia calda riassume i piedi.",
      "file": "c027.ogg",
      "durationSec": 4.056
    },
    {
      "index": 28,
      "text": "Lascia che il respiro si muova con le onde — lento dentro, più lungo fuori.",
      "file": "c028.ogg",
      "durationSec": 9.216
    },
    {
      "index": 29,
      "text": "La pace è la baia stessa. Tu sei al suo interno.",
      "file": "c029.ogg",
      "durationSec": 6.264
    },
    {
      "index": 30,
      "text": "Riposa la tua attenzione sul calore tra le scapole.",
      "file": "c030.ogg",
      "durationSec": 5.832
    },
    {
      "index": 31,
      "text": "E sull'aria salmastra fresca sulla punta del naso.",
      "file": "c031.ogg",
      "durationSec": 5.736
    },
    {
      "index": 32,
      "text": "Traccia la linea della scogliera con una immaginazione morbida.",
      "file": "c032.ogg",
      "durationSec": 6.6
    },
    {
      "index": 33,
      "text": "Pietra riscaldata dal giorno. Ombra fresca nelle pieghe.",
      "file": "c033.ogg",
      "durationSec": 6.456
    },
    {
      "index": 34,
      "text": "Una pozza di marea nelle vicinanze contiene un piccolo mondo limpido.",
      "file": "c034.ogg",
      "durationSec": 7.896
    },
    {
      "index": 35,
      "text": "Non devi avvicinarti. Sapere che è lì è sufficiente.",
      "file": "c035.ogg",
      "durationSec": 6.24
    },
    {
      "index": 36,
      "text": "Un'altra onda. Caviglie fresche. Sabbia calda. Respiro morbido.",
      "file": "c036.ogg",
      "durationSec": 8.88
    },
    {
      "index": 37,
      "text": "La baia continua a offrire la stessa semplice gentilezza.",
      "file": "c037.ogg",
      "durationSec": 6.768
    },
    {
      "index": 38,
      "text": "Accoglila ancora una volta prima di andartene.",
      "file": "c038.ogg",
      "durationSec": 4.968
    },
    {
      "index": 39,
      "text": "Ora riposa solo nel respiro per un po'.",
      "file": "c039.ogg",
      "durationSec": 4.104
    },
    {
      "index": 40,
      "text": "Inhala lentamente.",
      "file": "c040.ogg",
      "durationSec": 2.568
    },
    {
      "index": 41,
      "text": "Esala lentamente.",
      "file": "c041.ogg",
      "durationSec": 2.616
    },
    {
      "index": 42,
      "text": "Inhala.",
      "file": "c042.ogg",
      "durationSec": 1.872
    },
    {
      "index": 43,
      "text": "Esala.",
      "file": "c043.ogg",
      "durationSec": 1.872
    },
    {
      "index": 44,
      "text": "Senti il calore ovunque il corpo sia caldo.",
      "file": "c044.ogg",
      "durationSec": 4.968
    },
    {
      "index": 45,
      "text": "Senti la freschezza ovunque l'aria sia fresca.",
      "file": "c045.ogg",
      "durationSec": 5.184
    },
    {
      "index": 46,
      "text": "Inhala.",
      "file": "c046.ogg",
      "durationSec": 1.872
    },
    {
      "index": 47,
      "text": "Esala.",
      "file": "c047.ogg",
      "durationSec": 1.872
    },
    {
      "index": 48,
      "text": "Nessun posto dove andare. Niente da sistemare.",
      "file": "c048.ogg",
      "durationSec": 5.88
    },
    {
      "index": 49,
      "text": "Inhala.",
      "file": "c049.ogg",
      "durationSec": 1.872
    },
    {
      "index": 50,
      "text": "Esala.",
      "file": "c050.ogg",
      "durationSec": 1.872
    },
    {
      "index": 51,
      "text": "Riposa qui per qualche respiro tranquillo.",
      "file": "c051.ogg",
      "durationSec": 4.656
    },
    {
      "index": 52,
      "text": "Sappi che puoi tornare in questo posto in qualsiasi momento.",
      "file": "c052.ogg",
      "durationSec": 6.648
    },
    {
      "index": 53,
      "text": "Quando sei pronto, approfondisci il respiro.",
      "file": "c053.ogg",
      "durationSec": 5.4
    },
    {
      "index": 54,
      "text": "Muovi le dita delle mani e dei piedi.",
      "file": "c054.ogg",
      "durationSec": 4.152
    },
    {
      "index": 55,
      "text": "Apri gli occhi dolcemente.",
      "file": "c055.ogg",
      "durationSec": 3.12
    },
    {
      "index": 56,
      "text": "Porta con te un po' di questa pace.",
      "file": "c056.ogg",
      "durationSec": 3.672
    }
  ]
}
