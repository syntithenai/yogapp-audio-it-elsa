    },
    {
      "index": 28,
      "text": "[pausa:26]",
      "file": "c028.ogg",
      "durationSec": 3.264
    },
    {
      "index": 29,
      "text": "Ritorna al respiro naturale.",
      "file": "c029.ogg",
      "durationSec": 3.792
    },
    {
      "index": 30,
