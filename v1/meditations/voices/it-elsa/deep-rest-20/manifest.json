{
  "id": "deep-rest-20",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 358,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto in una pratica di riposo profondo.",
      "file": "c000.ogg",
      "durationSec": 4.872
    },
    {
      "index": 1,
      "text": "Stai sdraiato sulla schiena se puoi.",
      "file": "c001.ogg",
      "durationSec": 4.2
    },
    {
      "index": 2,
      "text": "Sostieni la testa e le ginocchia se ti aiuta.",
      "file": "c002.ogg",
      "durationSec": 4.944
    },
    {
      "index": 3,
      "text": "Lascia che le braccia riposino ai lati, con i palmi rilassati.",
      "file": "c003.ogg",
      "durationSec": 7.128
    },
    {
      "index": 4,
      "text": "Chiudi gli occhi.",
      "file": "c004.ogg",
      "durationSec": 2.112
    },
    {
      "index": 5,
      "text": "Non c'è nessun altro posto dove essere.",
      "file": "c005.ogg",
      "durationSec": 4.296
    },
    {
      "index": 6,
      "text": "[pausa:23]",
      "file": "c006.ogg",
      "durationSec": 2.904
    },
    {
      "index": 7,
      "text": "Senti i punti di contatto con il pavimento o il letto.",
      "file": "c007.ogg",
      "durationSec": 6.048
    },
    {
      "index": 8,
      "text": "Achilles. Anca. Scapole. Testa.",
      "file": "c008.ogg",
      "durationSec": 6.264
    },
    {
      "index": 9,
      "text": "Permetti al corpo di essere sostenuto.",
      "file": "c009.ogg",
      "durationSec": 4.344
    },
    {
      "index": 10,
      "text": "[pausa:23]",
      "file": "c010.ogg",
      "durationSec": 2.904
    },
    {
      "index": 11,
      "text": "Nota il respiro naturale.",
      "file": "c011.ogg",
      "durationSec": 3.552
    },
    {
      "index": 12,
      "text": "Non c'è bisogno di cambiarlo.",
      "file": "c012.ogg",
      "durationSec": 3.504
    },
    {
      "index": 13,
      "text": "L'inspirazione arriva.",
      "file": "c013.ogg",
      "durationSec": 3.12
    },
    {
      "index": 14,
      "text": "L'espirazione se ne va.",
      "file": "c014.ogg",
      "durationSec": 3.072
    },
    {
      "index": 15,
      "text": "[pausa:25]",
      "file": "c015.ogg",
      "durationSec": 3.528
    },
    {
      "index": 16,
      "text": "Se la mente è occupata, è permesso.",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "Puoi comunque riposare.",
      "file": "c017.ogg",
      "durationSec": 2.88
    },
    {
      "index": 18,
      "text": "Torna semplicemente alla sensazione.",
      "file": "c018.ogg",
      "durationSec": 4.368
    },
    {
      "index": 19,
      "text": "[pausa:23]",
      "file": "c019.ogg",
      "durationSec": 2.904
    },
    {
      "index": 20,
      "text": "Porta l'attenzione al piede destro.",
      "file": "c020.ogg",
      "durationSec": 4.08
    },
    {
      "index": 21,
      "text": "Dita. Pianta. Tacco.",
      "file": "c021.ogg",
      "durationSec": 4.68
    },
    {
      "index": 22,
      "text": "[pausa:21]",
      "file": "c022.ogg",
      "durationSec": 2.952
    },
    {
      "index": 23,
      "text": "Gamba inferiore destra.",
      "file": "c023.ogg",
      "durationSec": 3.072
    },
    {
      "index": 24,
      "text": "Ginocchio.",
      "file": "c024.ogg",
      "durationSec": 1.872
    },
    {
      "index": 25,
      "text": "Coscia.",
      "file": "c025.ogg",
      "durationSec": 1.872
    },
    {
      "index": 26,
      "text": "[pausa:21]",
      "file": "c026.ogg",
      "durationSec": 2.952
    },
    {
      "index": 27,
      "text": "Anca destra.",
      "file": "c027.ogg",
      "durationSec": 2.184
    },
    {
      "index": 28,
      "text": "Tutta la gamba destra, pesante e tranquilla.",
      "file": "c028.ogg",
      "durationSec": 5.52
    },
    {
      "index": 29,
      "text": "[pausa:23]",
      "file": "c029.ogg",
      "durationSec": 2.904
    },
    {
      "index": 30,
      "text": "Piede sinistro.",
      "file": "c030.ogg",
      "durationSec": 2.328
    },
    {
      "index": 31,
      "text": "Dita. Pianta. Tacco.",
      "file": "c031.ogg",
      "durationSec": 4.68
    },
    {
      "index": 32,
      "text": "[pausa:21]",
      "file": "c032.ogg",
      "durationSec": 2.952
    },
    {
      "index": 33,
      "text": "Gamba inferiore sinistra.",
      "file": "c033.ogg",
      "durationSec": 3.288
    },
    {
      "index": 34,
      "text": "Ginocchio.",
      "file": "c034.ogg",
      "durationSec": 1.872
    },
    {
      "index": 35,
      "text": "Coscia.",
      "file": "c035.ogg",
      "durationSec": 1.872
    },
    {
      "index": 36,
      "text": "[pausa:21]",
      "file": "c036.ogg",
      "durationSec": 2.952
    },
    {
      "index": 37,
      "text": "Anca sinistra.",
      "file": "c037.ogg",
      "durationSec": 2.256
    },
    {
      "index": 38,
      "text": "Tutta la gamba sinistra, pesante e tranquilla.",
      "file": "c038.ogg",
      "durationSec": 5.808
    },
    {
      "index": 39,
      "text": "[pausa:23]",
      "file": "c039.ogg",
      "durationSec": 2.904
    },
    {
      "index": 40,
      "text": "Pelvi e basso addome.",
      "file": "c040.ogg",
      "durationSec": 2.712
    },
    {
      "index": 41,
      "text": "Morbido.",
      "file": "c041.ogg",
      "durationSec": 1.872
    },
    {
      "index": 42,
      "text": "[pausa:21]",
      "file": "c042.ogg",
      "durationSec": 2.952
    },
    {
      "index": 43,
      "text": "Petto che sale e scende.",
      "file": "c043.ogg",
      "durationSec": 3.048
    },
    {
      "index": 44,
      "text": "Spazio del cuore aperto e rilassato.",
      "file": "c044.ogg",
      "durationSec": 4.512
    },
    {
      "index": 45,
      "text": "[pausa:23]",
      "file": "c045.ogg",
      "durationSec": 2.904
    },
    {
      "index": 46,
      "text": "Mano destra.",
      "file": "c046.ogg",
      "durationSec": 2.16
    },
    {
      "index": 47,
      "text": "Dita. Palma. Polso.",
      "file": "c047.ogg",
      "durationSec": 4.632
    },
    {
      "index": 48,
      "text": "[pausa:14]",
      "file": "c048.ogg",
      "durationSec": 4.392
    },
    {
      "index": 49,
      "text": "Braccio destro. Gomito. Spalla.",
      "file": "c049.ogg",
      "durationSec": 5.4
    },
    {
      "index": 50,
      "text": "[pausa:21]",
      "file": "c050.ogg",
      "durationSec": 2.952
    },
    {
      "index": 51,
      "text": "Mano sinistra.",
      "file": "c051.ogg",
      "durationSec": 2.376
    },
    {
      "index": 52,
      "text": "Dita. Palma. Polso.",
      "file": "c052.ogg",
      "durationSec": 4.632
    },
    {
      "index": 53,
      "text": "[pausa:14]",
      "file": "c053.ogg",
      "durationSec": 4.392
    },
    {
      "index": 54,
      "text": "Braccio sinistro. Gomito. Spalla.",
      "file": "c054.ogg",
      "durationSec": 5.592
    },
    {
      "index": 55,
      "text": "[pausa:23]",
      "file": "c055.ogg",
      "durationSec": 2.904
    },
    {
      "index": 56,
      "text": "Gola morbida.",
      "file": "c056.ogg",
      "durationSec": 2.088
    },
    {
      "index": 57,
      "text": "Mascella rilassata.",
      "file": "c057.ogg",
      "durationSec": 2.832
    },
    {
      "index": 58,
      "text": "Lingua in posizione rilassata.",
      "file": "c058.ogg",
      "durationSec": 3.912
    },
    {
      "index": 59,
      "text": "[pausa:21]",
      "file": "c059.ogg",
      "durationSec": 2.952
    },
    {
      "index": 60,
      "text": "Occhi riposano nelle orbite.",
      "file": "c060.ogg",
      "durationSec": 3.528
    },
    {
      "index": 61,
      "text": "Fronte liscia.",
      "file": "c061.ogg",
      "durationSec": 2.136
    },
    {
      "index": 62,
      "text": "Capo e sommità del cranio.",
      "file": "c062.ogg",
      "durationSec": 3.24
    },
    {
      "index": 63,
      "text": "[pausa:23]",
      "file": "c063.ogg",
      "durationSec": 2.904
    },
    {
      "index": 64,
      "text": "Senti tutto il corpo come un campo di quiete.",
      "file": "c064.ogg",
      "durationSec": 5.136
    },
    {
      "index": 65,
      "text": "Respirazione che lo attraversa come una marea silenziosa.",
      "file": "c065.ogg",
      "durationSec": 6.312
    },
    {
      "index": 66,
      "text": "[pausa:62]",
      "file": "c066.ogg",
      "durationSec": 3.864
    },
    {
      "index": 67,
      "text": "Rimani con tutto il corpo.",
      "file": "c067.ogg",
      "durationSec": 3.264
    },
    {
      "index": 68,
      "text": "[pausa:105]",
      "file": "c068.ogg",
      "durationSec": 3.672
    },
    {
      "index": 69,
      "text": "Dolce. Spazioso. Immobile.",
      "file": "c069.ogg",
      "durationSec": 5.448
    },
    {
      "index": 70,
      "text": "[pausa:55]",
      "file": "c070.ogg",
      "durationSec": 3.864
    },
    {
      "index": 71,
      "text": "Se appare un pensiero, lascialo passare come una nuvola.",
      "file": "c071.ogg",
      "durationSec": 6.456
    },
    {
      "index": 72,
      "text": "[pausa:50]",
      "file": "c072.ogg",
      "durationSec": 3.264
    },
    {
      "index": 73,
      "text": "Ritorna alla sensazione di essere sostenuto.",
      "file": "c073.ogg",
      "durationSec": 4.92
    },
    {
      "index": 74,
      "text": "[pausa:55]",
      "file": "c074.ogg",
      "durationSec": 3.864
    },
    {
      "index": 75,
      "text": "Riposa qui.",
      "file": "c075.ogg",
      "durationSec": 1.992
    },
    {
      "index": 76,
      "text": "Niente da risolvere.",
      "file": "c076.ogg",
      "durationSec": 2.808
    },
    {
      "index": 77,
      "text": "Niente da completare.",
      "file": "c077.ogg",
      "durationSec": 2.856
    },
    {
      "index": 78,
      "text": "[pausa:110]",
      "file": "c078.ogg",
      "durationSec": 3.84
    },
    {
      "index": 79,
      "text": "Se ti allontani, va bene.",
      "file": "c079.ogg",
      "durationSec": 3.576
    },
    {
      "index": 80,
      "text": "Se rimani consapevole, va bene anche questo.",
      "file": "c080.ogg",
      "durationSec": 5.376
    },
    {
      "index": 81,
      "text": "Entrambi sono riposo.",
      "file": "c081.ogg",
      "durationSec": 3.0
    },
    {
      "index": 82,
      "text": "[pausa:130]",
      "file": "c082.ogg",
      "durationSec": 3.576
    },
    {
      "index": 83,
      "text": "Riposa.",
      "file": "c083.ogg",
      "durationSec": 1.872
    },
    {
      "index": 84,
      "text": "[pausa:115]",
      "file": "c084.ogg",
      "durationSec": 4.032
    },
    {
      "index": 85,
      "text": "Comincia a notare di nuovo il respiro.",
      "file": "c085.ogg",
      "durationSec": 4.128
    },
    {
      "index": 86,
      "text": "Un po' più vivido ora.",
      "file": "c086.ogg",
      "durationSec": 2.832
    },
    {
      "index": 87,
      "text": "[pausa:23]",
      "file": "c087.ogg",
      "durationSec": 2.904
    },
    {
      "index": 88,
      "text": "Senti la stanza intorno a te.",
      "file": "c088.ogg",
      "durationSec": 3.672
    },
    {
      "index": 89,
      "text": "Suoni vicini e lontani.",
      "file": "c089.ogg",
      "durationSec": 3.312
    },
    {
      "index": 90,
      "text": "[pausa:21]",
      "file": "c090.ogg",
      "durationSec": 2.952
    },
    {
      "index": 91,
      "text": "Muovi le dita.",
      "file": "c091.ogg",
      "durationSec": 2.088
    },
    {
      "index": 92,
      "text": "Muovi i piedi.",
      "file": "c092.ogg",
      "durationSec": 2.256
    },
    {
      "index": 93,
      "text": "Ruota i polsi e le caviglie se vuoi.",
      "file": "c093.ogg",
      "durationSec": 4.128
    },
    {
      "index": 94,
      "text": "[pausa:21]",
      "file": "c094.ogg",
      "durationSec": 2.952
    },
    {
      "index": 95,
      "text": "Fai un respiro più profondo.",
      "file": "c095.ogg",
      "durationSec": 3.48
    },
    {
      "index": 96,
      "text": "E un lungo sospiro fuori.",
      "file": "c096.ogg",
      "durationSec": 3.24
    },
    {
      "index": 97,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c097.ogg",
      "durationSec": 4.488
    },
    {
      "index": 98,
      "text": "Ritorna lentamente.",
      "file": "c098.ogg",
      "durationSec": 2.904
    },
    {
      "index": 99,
      "text": "Porta con te un po' di questa quiete.",
      "file": "c099.ogg",
      "durationSec": 3.888
    }
  ]
}
