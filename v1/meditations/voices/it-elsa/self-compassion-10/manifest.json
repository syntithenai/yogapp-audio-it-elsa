{
  "id": "self-compassion-10",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 156,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 1.992
    },
    {
      "index": 1,
      "text": "Prenditi il tempo per arrivare.",
      "file": "c001.ogg",
      "durationSec": 3.36
    },
    {
      "index": 2,
      "text": "Siediti o sdraiati con supporto.",
      "file": "c002.ogg",
      "durationSec": 4.248
    },
    {
      "index": 3,
      "text": "Chiudi gli occhi se ti sembra sicuro.",
      "file": "c003.ogg",
      "durationSec": 3.696
    },
    {
      "index": 4,
      "text": "Senti il contatto con il suolo.",
      "file": "c004.ogg",
      "durationSec": 3.744
    },
    {
      "index": 5,
      "text": "Respira lentamente dentro.",
      "file": "c005.ogg",
      "durationSec": 3.408
    },
    {
      "index": 6,
      "text": "Respira più a lungo fuori.",
      "file": "c006.ogg",
      "durationSec": 3.264
    },
    {
      "index": 7,
      "text": "[pausa:26]",
      "file": "c007.ogg",
      "durationSec": 3.264
    },
    {
      "index": 8,
      "text": "Ancora una volta.",
      "file": "c008.ogg",
      "durationSec": 2.472
    },
    {
      "index": 9,
      "text": "[pausa:26]",
      "file": "c009.ogg",
      "durationSec": 3.264
    },
    {
      "index": 10,
      "text": "Lascia che le spalle si abbassino.",
      "file": "c010.ogg",
      "durationSec": 3.768
    },
    {
      "index": 11,
      "text": "Lascia che l'addome si rilassi.",
      "file": "c011.ogg",
      "durationSec": 3.576
    },
    {
      "index": 12,
      "text": "[pausa:32]",
      "file": "c012.ogg",
      "durationSec": 3.264
    },
    {
      "index": 13,
      "text": "Metti la mano sul cuore, se ti aiuta.",
      "file": "c013.ogg",
      "durationSec": 4.536
    },
    {
      "index": 14,
      "text": "Nota il tuo stato senza giudizio.",
      "file": "c014.ogg",
      "durationSec": 4.104
    },
    {
      "index": 15,
      "text": "[pausa:32]",
      "file": "c015.ogg",
      "durationSec": 3.264
    },
    {
      "index": 16,
      "text": "Questo è un momento di sofferenza, o di tensione umana ordinaria.",
      "file": "c016.ogg",
      "durationSec": 7.776
    },
    {
      "index": 17,
      "text": "Anche gli altri lo sentono.",
      "file": "c017.ogg",
      "durationSec": 3.048
    },
    {
      "index": 18,
      "text": "[pausa:39]",
      "file": "c018.ogg",
      "durationSec": 3.264
    },
    {
      "index": 19,
      "text": "Possano io essere gentile con me stesso in questo momento.",
      "file": "c019.ogg",
      "durationSec": 6.24
    },
    {
      "index": 20,
      "text": "[pausa:32]",
      "file": "c020.ogg",
      "durationSec": 3.264
    },
    {
      "index": 21,
      "text": "Possa accettare me stesso come sono.",
      "file": "c021.ogg",
      "durationSec": 4.152
    },
    {
      "index": 22,
      "text": "[pausa:32]",
      "file": "c022.ogg",
      "durationSec": 3.264
    },
    {
      "index": 23,
      "text": "Possa concedermi la compassione di cui ho bisogno.",
      "file": "c023.ogg",
      "durationSec": 5.376
    },
    {
      "index": 24,
      "text": "[pausa:39]",
      "file": "c024.ogg",
      "durationSec": 3.264
    },
    {
      "index": 25,
      "text": "Ripeti le frasi che ti arrivano. Lascia quelle che non ti arrivano.",
      "file": "c025.ogg",
      "durationSec": 6.84
    },
    {
      "index": 26,
      "text": "[pausa:52]",
      "file": "c026.ogg",
      "durationSec": 3.792
    },
    {
      "index": 27,
      "text": "Immagina di parlare a te stesso come farebbe un amico saggio.",
      "file": "c027.ogg",
      "durationSec": 6.456
    },
    {
      "index": 28,
      "text": "Quale tono userebbe?",
      "file": "c028.ogg",
      "durationSec": 2.664
    },
    {
      "index": 29,
      "text": "Offri a te stesso quel tono ora.",
      "file": "c029.ogg",
      "durationSec": 3.72
    },
    {
      "index": 30,
      "text": "[pausa:65]",
      "file": "c030.ogg",
      "durationSec": 3.984
    },
    {
      "index": 31,
      "text": "Inspira gentilezza.",
      "file": "c031.ogg",
      "durationSec": 3.024
    },
    {
      "index": 32,
      "text": "Espira durezza.",
      "file": "c032.ogg",
      "durationSec": 2.496
    },
    {
      "index": 33,
      "text": "[pausa:78]",
      "file": "c033.ogg",
      "durationSec": 3.816
    },
    {
      "index": 34,
      "text": "[pausa:39]",
      "file": "c034.ogg",
      "durationSec": 3.264
    },
    {
      "index": 35,
      "text": "Inizia a approfondire il respiro.",
      "file": "c035.ogg",
      "durationSec": 3.936
    },
    {
      "index": 36,
      "text": "Rivivi la sensazione della stanza.",
      "file": "c036.ogg",
      "durationSec": 4.104
    },
    {
      "index": 37,
      "text": "Muovi le dita delle mani e dei piedi.",
      "file": "c037.ogg",
      "durationSec": 4.152
    },
    {
      "index": 38,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c038.ogg",
      "durationSec": 4.488
    },
    {
      "index": 39,
      "text": "Muoviti lentamente verso ciò che segue.",
      "file": "c039.ogg",
      "durationSec": 4.416
    }
  ]
}
