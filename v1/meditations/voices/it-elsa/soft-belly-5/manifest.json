{
  "id": "soft-belly-5",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 125,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 1.992
    },
    {
      "index": 1,
      "text": "Trova una posizione comoda, o sdraiati se ti senti meglio così.",
      "file": "c001.ogg",
      "durationSec": 7.224
    },
    {
      "index": 2,
      "text": "Lascia riposare le mani.",
      "file": "c002.ogg",
      "durationSec": 3.0
    },
    {
      "index": 3,
      "text": "Rilassate gli occhi, oppure chiudeteli.",
      "file": "c003.ogg",
      "durationSec": 4.752
    },
    {
      "index": 4,
      "text": "Fai un respiro lento all’ingresso.",
      "file": "c004.ogg",
      "durationSec": 3.816
    },
    {
      "index": 5,
      "text": "E un respiro più lungo all’uscita.",
      "file": "c005.ogg",
      "durationSec": 3.816
    },
    {
      "index": 6,
      "text": "Posiziona una mano sull'addome inferiore se ti piace.",
      "file": "c006.ogg",
      "durationSec": 5.784
    },
    {
      "index": 7,
      "text": "Notare se l’addome sta tenendo.",
      "file": "c007.ogg",
      "durationSec": 3.864
    },
    {
      "index": 8,
      "text": "[pausa:20]",
      "file": "c008.ogg",
      "durationSec": 2.952
    },
    {
      "index": 9,
      "text": "All'inspirazione successiva, lascia che la pancia si espanda.",
      "file": "c009.ogg",
      "durationSec": 6.936
    },
    {
      "index": 10,
      "text": "All'espirazione, lasciala cadere senza stringere.",
      "file": "c010.ogg",
      "durationSec": 5.952
    },
    {
      "index": 11,
      "text": "[pausa:20]",
      "file": "c011.ogg",
      "durationSec": 2.952
    },
    {
      "index": 12,
      "text": "Ancora. Pancia morbida dentro.",
      "file": "c012.ogg",
      "durationSec": 4.344
    },
    {
      "index": 13,
      "text": "Pancia morbida fuori.",
      "file": "c013.ogg",
      "durationSec": 2.688
    },
    {
      "index": 14,
      "text": "[pausa:25]",
      "file": "c014.ogg",
      "durationSec": 3.528
    },
    {
      "index": 15,
      "text": "Se la mente discute, lascia che il corpo guidi.",
      "file": "c015.ogg",
      "durationSec": 5.448
    },
    {
      "index": 16,
      "text": "Espansione. Rilascio.",
      "file": "c016.ogg",
      "durationSec": 3.912
    },
    {
      "index": 17,
      "text": "[pausa:29]",
      "file": "c017.ogg",
      "durationSec": 3.264
    },
    {
      "index": 18,
      "text": "Le spalle si rilassano.",
      "file": "c018.ogg",
      "durationSec": 3.336
    },
    {
      "index": 19,
      "text": "La mascella si rilassa.",
      "file": "c019.ogg",
      "durationSec": 3.096
    },
    {
      "index": 20,
      "text": "Pancia libera.",
      "file": "c020.ogg",
      "durationSec": 1.968
    },
    {
      "index": 21,
      "text": "[pausa:25]",
      "file": "c021.ogg",
      "durationSec": 3.528
    },
    {
      "index": 22,
      "text": "Resta con dieci respiri tranquilli e morbidi della pancia.",
      "file": "c022.ogg",
      "durationSec": 6.864
    },
    {
      "index": 23,
      "text": "[pausa:45]",
      "file": "c023.ogg",
      "durationSec": 3.672
    },
    {
      "index": 24,
      "text": "Notare qualsiasi facilità che è arrivata.",
      "file": "c024.ogg",
      "durationSec": 4.8
    },
    {
      "index": 25,
      "text": "[pausa:20]",
      "file": "c025.ogg",
      "durationSec": 2.952
    },
    {
      "index": 26,
      "text": "Riposa qui.",
      "file": "c026.ogg",
      "durationSec": 1.992
    },
    {
      "index": 27,
      "text": "[pausa:27]",
      "file": "c027.ogg",
      "durationSec": 3.384
    },
    {
      "index": 28,
      "text": "Fai un altro respiro facile.",
      "file": "c028.ogg",
      "durationSec": 3.456
    },
    {
      "index": 29,
      "text": "Muovi le dita.",
      "file": "c029.ogg",
      "durationSec": 2.088
    },
    {
      "index": 30,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c030.ogg",
      "durationSec": 4.488
    },
    {
      "index": 31,
      "text": "Porta con te un po' di questo.",
      "file": "c031.ogg",
      "durationSec": 3.24
    }
  ]
}
