{
  "id": "gratitude-5",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 124,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 1.992
    },
    {
      "index": 1,
      "text": "Trova una posizione comoda, o sdraiati se ti sembra meglio.",
      "file": "c001.ogg",
      "durationSec": 6.888
    },
    {
      "index": 2,
      "text": "Lascia riposare le mani.",
      "file": "c002.ogg",
      "durationSec": 3.0
    },
    {
      "index": 3,
      "text": "Ammorbidisci gli occhi, o chiudili.",
      "file": "c003.ogg",
      "durationSec": 4.104
    },
    {
      "index": 4,
      "text": "Fai un respiro lento e profondo.",
      "file": "c004.ogg",
      "durationSec": 3.912
    },
    {
      "index": 5,
      "text": "E un respiro più lungo in uscita.",
      "file": "c005.ogg",
      "durationSec": 3.816
    },
    {
      "index": 6,
      "text": "Porta alla mente una piccola cosa che ti ha aiutato oggi, o questa settimana.",
      "file": "c006.ogg",
      "durationSec": 7.92
    },
    {
      "index": 7,
      "text": "Può essere qualcosa di ordinario. Acqua calda. Un messaggio. Una luce su un muro.",
      "file": "c007.ogg",
      "durationSec": 10.056
    },
    {
      "index": 8,
      "text": "[pausa:21]",
      "file": "c008.ogg",
      "durationSec": 2.952
    },
    {
      "index": 9,
      "text": "Tienilo delicatamente nella consapevolezza.",
      "file": "c009.ogg",
      "durationSec": 4.824
    },
    {
      "index": 10,
      "text": "Nota qualsiasi ammorbidimento nel petto o nel viso.",
      "file": "c010.ogg",
      "durationSec": 6.168
    },
    {
      "index": 11,
      "text": "[pausa:26]",
      "file": "c011.ogg",
      "durationSec": 3.264
    },
    {
      "index": 12,
      "text": "In silenzio, ringrazia questa cosa.",
      "file": "c012.ogg",
      "durationSec": 4.632
    },
    {
      "index": 13,
      "text": "Grazie per essere qui.",
      "file": "c013.ogg",
      "durationSec": 2.784
    },
    {
      "index": 14,
      "text": "[pausa:21]",
      "file": "c014.ogg",
      "durationSec": 2.952
    },
    {
      "index": 15,
      "text": "Ora una seconda cosa. Un altro piccolo bene.",
      "file": "c015.ogg",
      "durationSec": 5.52
    },
    {
      "index": 16,
      "text": "[pausa:26]",
      "file": "c016.ogg",
      "durationSec": 3.264
    },
    {
      "index": 17,
      "text": "Grazie.",
      "file": "c017.ogg",
      "durationSec": 1.872
    },
    {
      "index": 18,
      "text": "[pausa:15]",
      "file": "c018.ogg",
      "durationSec": 3.864
    },
    {
      "index": 19,
      "text": "E ancora una. Una terza.",
      "file": "c019.ogg",
      "durationSec": 4.008
    },
    {
      "index": 20,
      "text": "[pausa:26]",
      "file": "c020.ogg",
      "durationSec": 3.264
    },
    {
      "index": 21,
      "text": "Lascia che la gratitudine sia semplice. Non forzata. Solo notata.",
      "file": "c021.ogg",
      "durationSec": 8.64
    },
    {
      "index": 22,
      "text": "[pausa:31]",
      "file": "c022.ogg",
      "durationSec": 3.096
    },
    {
      "index": 23,
      "text": "Riposa in quel calore per qualche respiro.",
      "file": "c023.ogg",
      "durationSec": 4.56
    },
    {
      "index": 24,
      "text": "[pausa:41]",
      "file": "c024.ogg",
      "durationSec": 3.408
    },
    {
      "index": 25,
      "text": "Fai un altro respiro facile.",
      "file": "c025.ogg",
      "durationSec": 3.456
    },
    {
      "index": 26,
      "text": "Muovi le dita.",
      "file": "c026.ogg",
      "durationSec": 2.088
    },
    {
      "index": 27,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c027.ogg",
      "durationSec": 4.488
    },
    {
      "index": 28,
      "text": "Porta con te un po' di questo.",
      "file": "c028.ogg",
      "durationSec": 3.24
    }
  ]
}
