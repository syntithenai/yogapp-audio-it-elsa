{
  "id": "morning-energy-5",
  "voiceId": "it-elsa",
  "edgeVoice": "it-IT-ElsaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 279,
  "chunks": [
    {
      "index": 0,
      "text": "Buongiorno.",
      "file": "c000.ogg",
      "durationSec": 1.968
    },
    {
      "index": 1,
      "text": "Benvenuto a una breve pratica per affrontare la giornata.",
      "file": "c001.ogg",
      "durationSec": 6.048
    },
    {
      "index": 2,
      "text": "Siediti dritto, o stai in piedi se ti sembra meglio.",
      "file": "c002.ogg",
      "durationSec": 6.024
    },
    {
      "index": 3,
      "text": "Lascia che i tuoi occhi si ammorbidiscano, o chiudili.",
      "file": "c003.ogg",
      "durationSec": 6.024
    },
    {
      "index": 4,
      "text": "Senti i piedi sul pavimento.",
      "file": "c004.ogg",
      "durationSec": 3.672
    },
    {
      "index": 5,
      "text": "Fai un respiro lento attraverso il naso.",
      "file": "c005.ogg",
      "durationSec": 4.44
    },
    {
      "index": 6,
      "text": "E un respiro più pieno attraverso la bocca.",
      "file": "c006.ogg",
      "durationSec": 4.92
    },
    {
      "index": 7,
      "text": "Ancora. Inhala delicatamente.",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "Esala completamente.",
      "file": "c008.ogg",
      "durationSec": 2.928
    },
    {
      "index": 9,
      "text": "Un altro. Riempì il petto.",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "Svuotalo completamente.",
      "file": "c010.ogg",
      "durationSec": 3.216
    },
    {
      "index": 11,
      "text": "[pausa:4]",
      "file": "c011.ogg",
      "durationSec": 3.048
    },
    {
      "index": 12,
      "text": "Guarda avanti alla giornata senza stringerla.",
      "file": "c012.ogg",
      "durationSec": 4.92
    },
    {
      "index": 13,
      "text": "Non hai bisogno della mappa completa ancora.",
      "file": "c013.ogg",
      "durationSec": 4.728
    },
    {
      "index": 14,
      "text": "Solo il prossimo passo onesto.",
      "file": "c014.ogg",
      "durationSec": 3.672
    },
    {
      "index": 15,
      "text": "[pausa:5]",
      "file": "c015.ogg",
      "durationSec": 2.928
    },
    {
      "index": 16,
      "text": "Inspira per quattro.",
      "file": "c016.ogg",
      "durationSec": 2.808
    },
    {
      "index": 17,
      "text": "Due. Tre. Quattro.",
      "file": "c017.ogg",
      "durationSec": 4.272
    },
    {
      "index": 18,
      "text": "Espira per quattro.",
      "file": "c018.ogg",
      "durationSec": 2.616
    },
    {
      "index": 19,
      "text": "Due. Tre. Quattro.",
      "file": "c019.ogg",
      "durationSec": 4.272
    },
    {
      "index": 20,
      "text": "Ancora, al tuo ritmo.",
      "file": "c020.ogg",
      "durationSec": 3.384
    },
    {
      "index": 21,
      "text": "[pausa:6]",
      "file": "c021.ogg",
      "durationSec": 3.0
    },
    {
      "index": 22,
      "text": "Senti il calore nelle mani.",
      "file": "c022.ogg",
      "durationSec": 3.384
    },
    {
      "index": 23,
      "text": "Senti la prontezza nelle gambe.",
      "file": "c023.ogg",
      "durationSec": 3.72
    },
    {
      "index": 24,
      "text": "[pausa:4]",
      "file": "c024.ogg",
      "durationSec": 3.048
    },
    {
      "index": 25,
      "text": "Ruota le spalle in su, indietro e giù.",
      "file": "c025.ogg",
      "durationSec": 4.752
    },
    {
      "index": 26,
      "text": "Rilassa la mascella.",
      "file": "c026.ogg",
      "durationSec": 2.736
    },
    {
      "index": 27,
      "text": "Rilassa l'addome.",
      "file": "c027.ogg",
      "durationSec": 2.352
    },
    {
      "index": 28,
      "text": "Notare qualsiasi traccia di sonno nel corpo.",
      "file": "c028.ogg",
      "durationSec": 4.896
    },
    {
      "index": 29,
      "text": "Non c'è bisogno di spingerlo via.",
      "file": "c029.ogg",
      "durationSec": 4.032
    },
    {
      "index": 30,
      "text": "Inspira nei lati delle costole.",
      "file": "c030.ogg",
      "durationSec": 3.768
    },
    {
      "index": 31,
      "text": "E lascia che si restringano in espirazione.",
      "file": "c031.ogg",
      "durationSec": 4.728
    },
    {
      "index": 32,
      "text": "[pausa:5]",
      "file": "c032.ogg",
      "durationSec": 2.928
    },
    {
      "index": 33,
      "text": "Ora porta un po' di luminosità al respiro.",
      "file": "c033.ogg",
      "durationSec": 4.536
    },
    {
      "index": 34,
      "text": "Inspira come se stessi svegliandoti dall'interno.",
      "file": "c034.ogg",
      "durationSec": 5.592
    },
    {
      "index": 35,
      "text": "Espira qualsiasi peso di ieri.",
      "file": "c035.ogg",
      "durationSec": 3.936
    },
    {
      "index": 36,
      "text": "Inspira possibilità.",
      "file": "c036.ogg",
      "durationSec": 2.856
    },
    {
      "index": 37,
      "text": "Esprima sforzo che non è ancora necessario.",
      "file": "c037.ogg",
      "durationSec": 4.8
    },
    {
      "index": 38,
      "text": "[pausa:4]",
      "file": "c038.ogg",
      "durationSec": 3.048
    },
    {
      "index": 39,
      "text": "Posiziona una mano sul cuore o lascia entrambe le mani in grembo.",
      "file": "c039.ogg",
      "durationSec": 6.864
    },
    {
      "index": 40,
      "text": "Silenziosamente, oppure semplicemente ascoltando, prova queste frasi.",
      "file": "c040.ogg",
      "durationSec": 8.976
    },
    {
      "index": 41,
      "text": "Sono qui.",
      "file": "c041.ogg",
      "durationSec": 1.872
    },
    {
      "index": 42,
      "text": "Ricomincio da capo.",
      "file": "c042.ogg",
      "durationSec": 2.64
    },
    {
      "index": 43,
      "text": "Ho abbastanza per questa mattina.",
      "file": "c043.ogg",
      "durationSec": 3.792
    },
    {
      "index": 44,
      "text": "[pausa:4]",
      "file": "c044.ogg",
      "durationSec": 3.048
    },
    {
      "index": 45,
      "text": "Mi muovo con stabilità.",
      "file": "c045.ogg",
      "durationSec": 3.024
    },
    {
      "index": 46,
      "text": "Incontro ciò che arriva con la mente chiara.",
      "file": "c046.ogg",
      "durationSec": 4.392
    },
    {
      "index": 47,
      "text": "Sono autorizzato/a a occupare spazio oggi.",
      "file": "c047.ogg",
      "durationSec": 4.944
    },
    {
      "index": 48,
      "text": "[pausa:5]",
      "file": "c048.ogg",
      "durationSec": 2.928
    },
    {
      "index": 49,
      "text": "Scelgo un'intenzione chiara per oggi.",
      "file": "c049.ogg",
      "durationSec": 4.176
    },
    {
      "index": 50,
      "text": "Può essere semplice.",
      "file": "c050.ogg",
      "durationSec": 2.592
    },
    {
      "index": 51,
      "text": "Gentilezza. Concentrazione. Pazienza. Energia.",
      "file": "c051.ogg",
      "durationSec": 8.376
    },
    {
      "index": 52,
      "text": "Mantieni quella parola per un respiro.",
      "file": "c052.ogg",
      "durationSec": 4.32
    },
    {
      "index": 53,
      "text": "[pausa:6]",
      "file": "c053.ogg",
      "durationSec": 3.0
    },
    {
      "index": 54,
      "text": "Vedi te stesso/a muovere attraverso la mattina con quella qualità.",
      "file": "c054.ogg",
      "durationSec": 7.2
    },
    {
      "index": 55,
      "text": "[pausa:5]",
      "file": "c055.ogg",
      "durationSec": 2.928
    },
    {
      "index": 56,
      "text": "[pausa:5]",
      "file": "c056.ogg",
      "durationSec": 2.928
    },
    {
      "index": 57,
      "text": "Allunga le dita, poi rilassale.",
      "file": "c057.ogg",
      "durationSec": 4.368
    },
    {
      "index": 58,
      "text": "Solleva leggermente gli angoli della bocca se ti senti di farlo.",
      "file": "c058.ogg",
      "durationSec": 6.768
    },
    {
      "index": 59,
      "text": "[pausa:3]",
      "file": "c059.ogg",
      "durationSec": 2.424
    },
    {
      "index": 60,
      "text": "Percepisci la colonna vertebrale che si allunga con il prossimo respiro in.",
      "file": "c060.ogg",
      "durationSec": 8.568
    },
    {
      "index": 61,
      "text": "Percepisci le spalle rilassarsi con l'espirazione.",
      "file": "c061.ogg",
      "durationSec": 5.928
    },
    {
      "index": 62,
      "text": "Un'ultima respirazione luminosa in.",
      "file": "c062.ogg",
      "durationSec": 4.512
    },
    {
      "index": 63,
      "text": "E un respiro lungo e facile fuori.",
      "file": "c063.ogg",
      "durationSec": 4.104
    },
    {
      "index": 64,
      "text": "Muovi le dita.",
      "file": "c064.ogg",
      "durationSec": 2.088
    },
    {
      "index": 65,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c065.ogg",
      "durationSec": 4.488
    },
    {
      "index": 66,
      "text": "Porta questa energia tranquilla nella tua giornata.",
      "file": "c066.ogg",
      "durationSec": 5.64
    }
  ]
}
